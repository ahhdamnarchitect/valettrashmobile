# Copy to .env for local dev. Use separate projects for staging vs production.
# API keys: https://supabase.com/dashboard/project/<ref>/settings/api
#
# NEVER put service_role in the Flutter app — anon key only.

# Dev (localhost:8091)
SUPABASE_URL=https://airpwzzkyjqzeeqizvft.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Staging — uncomment when staging project exists
# SUPABASE_URL=https://your-staging-ref.supabase.co
# SUPABASE_ANON_KEY=your-staging-anon-key

# Production release builds — use prod project keys only
# SUPABASE_URL=https://your-prod-ref.supabase.co
# SUPABASE_ANON_KEY=your-prod-anon-key
