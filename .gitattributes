# Normalize all text files to LF in the repository and in the working tree.
# Fixes the CRLF/LF churn that made ~90 files show as "modified" whenever the
# repo was touched from both Windows and macOS. See brain/next_steps.md.
* text=auto eol=lf

# Binary assets — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
*.jar  binary
*.keystore binary
*.jks  binary
*.p12  binary
*.mobileprovision binary

# Generated / vendored — keep out of diffs and language stats.
mobile/pubspec.lock -diff linguist-generated
